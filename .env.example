# Datadog credentials (API key + application key with apm_read)
DD_API_KEY=your_api_key_here
DD_APP_KEY=your_app_key_here
# datadoghq.com, datadoghq.eu, us3.datadoghq.com, us5.datadoghq.com, ap1.datadoghq.com
DD_SITE=datadoghq.com

# Target APM service and environment. Optional here when given with
# --service/--env or in the --config file. System boundary, classification,
# ignore and person settings are not environment variables: use flags or the
# config file (see examples/checkout-web/c4.toml).
DD_SERVICE=checkout-web
DD_ENV=prod

# Lookback window for dependencies and span resources
DD_LOOKBACK_HOURS=24

OUTPUT_DIR=output
